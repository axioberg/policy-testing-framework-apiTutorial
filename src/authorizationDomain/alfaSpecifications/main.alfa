namespace tutorial {

import Attributes.*	
import tutorial.records.*
import tutorial.attributes.*

/*
 * The Main Policyset
 */
policyset main{
	apply firstApplicable
	policy emergency{
		apply firstApplicable
		rule denyAll{
			deny
		}
	}
	/*
	 * Tutorial Record policy
	 */
	policyset tutorialRecords{
		target clause stringEndsWith("/record", api.path)
	    apply firstApplicable	
	    mainRecords
	} //tutorialRecords
} // main



} // tutorial